{
  "name": "traliran-ai-hub",
  "version": "2.0.0",
  "private": true,
  "description": "Traliran AI Hub - serverless AI chat, in-browser IDE and RAG playground (AGPL-3.0). Fork with Android (Capacitor) packaging.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:www": "node scripts/build-www.mjs",
    "build": "npm run build:vendor && npm run build:www",
    "cap:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "marked": "18.1.0",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.36.0",
    "@tailwindcss/cli": "4.3.3",
    "codemirror": "^6.0.1",
    "esbuild": "^0.28.2",
    "monaco-editor": "0.44.0",
    "tailwindcss": "4.3.3"
  }
}
